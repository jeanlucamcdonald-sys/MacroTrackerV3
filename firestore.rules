rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function macros(value) {
      return value is map && value.keys().hasAll(['cal', 'p', 'c', 'f'])
        && value.cal is number && value.cal >= 0 && value.cal <= 100000
        && value.p is number && value.p >= 0 && value.p <= 100000
        && value.c is number && value.c >= 0 && value.c <= 100000
        && value.f is number && value.f >= 0 && value.f <= 100000;
    }
    function targets(value) {
      return macros(value) && value.cal - (4 * value.p + 4 * value.c + 9 * value.f) < 0.001
        && (4 * value.p + 4 * value.c + 9 * value.f) - value.cal < 0.001;
    }
    // Legacy profile name lookup only; canonical writes use profile/current.
    match /users/{uid} {
      allow read: if owner(uid);
    }
    match /users/{uid}/profile/current {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['version', 'profile', 'settings', 'targets', '_revision'])
        && request.resource.data.profile is map && request.resource.data.settings is map
        && request.resource.data.version is string && targets(request.resource.data.targets)
        && request.resource.data._revision is int && request.resource.data._revision > 0;
      allow delete: if owner(uid);
    }
    match /users/{uid}/catalog/current {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['foodDatabase', 'recipes', '_revision'])
        && request.resource.data.foodDatabase is list && request.resource.data.recipes is list
        && request.resource.data._revision is int && request.resource.data._revision > 0;
      allow delete: if owner(uid);
    }
    match /users/{uid}/logs/{date} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'totals', 'diary', '_revision'])
        && request.resource.data.date == date && macros(request.resource.data.totals)
        && request.resource.data.diary is list && request.resource.data.diary.size() <= 1000
        && request.resource.data._revision is int && request.resource.data._revision > 0;
      allow delete: if owner(uid);
    }
    match /users/{uid}/weightLogs/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['id', 'timestamp', 'value', 'unit', '_revision'])
        && request.resource.data.value is number && request.resource.data.value > 0 && request.resource.data.value < 2000
        && request.resource.data.timestamp is string && request.resource.data.unit in ['kg', 'lb']
        && request.resource.data.id == id && request.resource.data._revision is int && request.resource.data._revision > 0;
      allow delete: if owner(uid);
    }
  }
}
